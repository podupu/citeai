# Copy to .env before `docker compose up`. Generate secrets with `openssl rand -base64 32`.

DEPLOYMENT_MODE=local
VITE_DEPLOYMENT_MODE=local

BETTER_AUTH_SECRET=change-me
ELMO_ENCRYPTION_KEY=change-me

APP_NAME=Elmo
APP_ICON=/icons/elmo-icon.svg
VITE_APP_NAME=Elmo
VITE_APP_ICON=/icons/elmo-icon.svg

# Matches the `postgres` service in docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/elmo

# Host port the web service is published on (docker-compose.yml default: 1515).
WEB_PORT=1515
APP_URL=http://localhost:1515
VITE_APP_URL=http://localhost:1515

# Provider credentials. Placeholders are accepted by env validation but prompt
# runs will fail until real keys are set.
ANTHROPIC_API_KEY=sk-ant-placeholder
OPENAI_API_KEY=sk-placeholder
DATAFORSEO_LOGIN=placeholder@example.com
DATAFORSEO_PASSWORD=placeholder
SCRAPE_TARGETS=claude:anthropic-api:claude-sonnet-5,chatgpt:openai-api:gpt-5-mini:online

DISABLE_TELEMETRY=1
